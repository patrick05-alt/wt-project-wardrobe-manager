{
  "manifest_version": 3,
  "name": "Wardrobe Manager",
  "version": "0.1.0",
  "description": "Manage Vinted wardrobe items, backups, analytics and safe draft relisting without automatic publishing.",
  "action": {
    "default_title": "Wardrobe manager",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "webRequest", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "24": "icons/icon24.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://www.vinted.fr/*",
    "https://www.vinted.de/*",
    "https://www.vinted.it/*",
    "https://www.vinted.es/*",
    "https://www.vinted.pt/*",
    "https://www.vinted.nl/*",
    "https://www.vinted.be/*",
    "https://www.vinted.pl/*",
    "https://www.vinted.cz/*",
    "https://www.vinted.sk/*",
    "https://www.vinted.hu/*",
    "https://www.vinted.ro/*",
    "https://www.vinted.bg/*",
    "https://www.vinted.lt/*",
    "https://www.vinted.lv/*",
    "https://www.vinted.ee/*",
    "https://www.vinted.gr/*",
    "https://www.vinted.si/*",
    "https://www.vinted.hr/*",
    "https://www.vinted.ie/*",
    "https://www.vinted.at/*",
    "https://www.vinted.ch/*",
    "https://www.vinted.dk/*",
    "https://www.vinted.se/*",
    "https://www.vinted.no/*",
    "https://www.vinted.fi/*",
    "https://www.vinted.co.uk/*",
    "https://www.vinted.com/*",
    "https://images*.vinted.net/*",
    "https://images*.vinted.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.vinted.fr/member/*",
        "https://www.vinted.fr/items/*",
        "https://www.vinted.de/member/*",
        "https://www.vinted.de/items/*",
        "https://www.vinted.it/member/*",
        "https://www.vinted.it/items/*",
        "https://www.vinted.es/member/*",
        "https://www.vinted.es/items/*",
        "https://www.vinted.pt/member/*",
        "https://www.vinted.pt/items/*",
        "https://www.vinted.nl/member/*",
        "https://www.vinted.nl/items/*",
        "https://www.vinted.be/member/*",
        "https://www.vinted.be/items/*",
        "https://www.vinted.pl/member/*",
        "https://www.vinted.pl/items/*",
        "https://www.vinted.cz/member/*",
        "https://www.vinted.cz/items/*",
        "https://www.vinted.sk/member/*",
        "https://www.vinted.sk/items/*",
        "https://www.vinted.hu/member/*",
        "https://www.vinted.hu/items/*",
        "https://www.vinted.ro/member/*",
        "https://www.vinted.ro/items/*",
        "https://www.vinted.bg/member/*",
        "https://www.vinted.bg/items/*",
        "https://www.vinted.lt/member/*",
        "https://www.vinted.lt/items/*",
        "https://www.vinted.lv/member/*",
        "https://www.vinted.lv/items/*",
        "https://www.vinted.ee/member/*",
        "https://www.vinted.ee/items/*",
        "https://www.vinted.gr/member/*",
        "https://www.vinted.gr/items/*",
        "https://www.vinted.si/member/*",
        "https://www.vinted.si/items/*",
        "https://www.vinted.hr/member/*",
        "https://www.vinted.hr/items/*",
        "https://www.vinted.ie/member/*",
        "https://www.vinted.ie/items/*",
        "https://www.vinted.at/member/*",
        "https://www.vinted.at/items/*",
        "https://www.vinted.ch/member/*",
        "https://www.vinted.ch/items/*",
        "https://www.vinted.dk/member/*",
        "https://www.vinted.dk/items/*",
        "https://www.vinted.se/member/*",
        "https://www.vinted.se/items/*",
        "https://www.vinted.no/member/*",
        "https://www.vinted.no/items/*",
        "https://www.vinted.fi/member/*",
        "https://www.vinted.fi/items/*",
        "https://www.vinted.co.uk/member/*",
        "https://www.vinted.co.uk/items/*",
        "https://www.vinted.com/member/*",
        "https://www.vinted.com/items/*"
      ],
      "css": ["wardrobe-manager.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
